{
  "name": "hasi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "catalog:sync": "node --env-file-if-exists=.env.local scripts/sync-hasi-catalog.mjs",
    "catalog:sync:local": "node --env-file-if-exists=.env.local scripts/sync-hasi-catalog.mjs --local",
    "db:reset": "node --env-file-if-exists=.env.local scripts/reset-database.mjs",
    "dev:local": "npm run catalog:sync:local && HASI_LOCAL_DB=1 next dev",
    "seed": "node --env-file-if-exists=.env.local scripts/sync-hasi-catalog.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@types/jsonwebtoken": "^9.0.10",
